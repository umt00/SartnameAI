# SartnameAI Yapılandırma Şablonu

# Depolama Yapılandırması (local | azure_blob)
STORAGE_BACKEND=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=sartnameler
SAS_TOKEN_EXPIRY_HOURS=24

# Web Arama Motoru (offline | ddg | azure_search)
SEARCH_PROVIDER=offline
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX_NAME=sartname-index

# FastMCP Sunucu Port Dağılımı
SERVER_HOST=0.0.0.0
PIPELINE_PORT=8001
GENERATOR_PORT=8002
MATCHER_PORT=8003
DEBUG=false
